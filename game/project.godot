config_version=5

[application]
config/name="殖民契约 · COLONY CHARTER 1.8"
config/version="1.8.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="ColonyCharter/v18"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icons/port.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.071,0.11,1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
