# Godot editor cache
game/.godot/

# Build outputs, frozen releases and raw run output (kept on disk, never in history)
build/
delivery/
versions/
evidence/
saves/

# Large third-party tools
tools/*.zip
tools/*.tpz
tools/godot-4.5.1/

# Separate 3ds Max modelling task; its brief keeps it apart from the game project
art_reserve/

# Transient files
*.bak
*.tmp
__pycache__/
